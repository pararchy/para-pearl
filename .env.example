# BUBBLE_API_TOKEN — from your Bubble editor: Settings → API → API tokens
BUBBLE_API_TOKEN=

# BUBBLE_APP_HOST — your app's root URL, no trailing slash.
# Custom domain or *.bubbleapps.io both work.
BUBBLE_APP_HOST=https://yourapp.bubbleapps.io

# BUBBLE_DEV_VERSION — the version slug Pearl treats as the dev workbench.
# Bubble's default is "version-test"; custom versions appear in the editor URL.
BUBBLE_DEV_VERSION=version-test

# Optional second credential — Pearl will use it if you pass key:'alt'.
# BUBBLE_ALT_TOKEN=
